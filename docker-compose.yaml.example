# hulibaza stack: Postgres + Qdrant + GPU embedder/reranker + MCP server.
#
#   cp docker-compose.yaml.example docker-compose.yaml
#   # point ./YOUR_KNOWLEDGE_BASE at your docs directory, then:
#   docker compose up -d postgres qdrant
#   docker compose up -d llama-server   # local embedder + reranker (optional)
#   docker compose up -d hulibaza       # builds the image; MCP on :59980
#
# Ports: PG 59942, Qdrant 59943, llama 59944, MCP 59980.

name: hulibaza

services:
  qdrant:
    image: qdrant/qdrant:v1.14.0
    restart: unless-stopped
    ports:
      - "59943:6333"
    volumes:
      - ./qdrant_data:/qdrant/storage
    # Qdrant/RocksDB open many files per segment; the 1024 default breaks.
    ulimits:
      nofile:
        soft: 65536
        hard: 524288
    healthcheck:
      test: ["CMD-SHELL", "bash -c 'echo > /dev/tcp/localhost/6333'"]
      interval: 5s
      timeout: 3s
      retries: 5

  postgres:
    image: postgres:17.9-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: hulibaza
      POSTGRES_PASSWORD: hulibaza
      POSTGRES_DB: hulibaza
    ports:
      - "59942:5432"
    volumes:
      - ./pg_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U hulibaza"]
      interval: 5s
      timeout: 3s
      retries: 5

  # MCP server (streamable-HTTP). Needs config.yaml, ./tokenizers/, and the
  # knowledge base at wiki_dir.
  hulibaza:
    build: .
    restart: unless-stopped
    ports:
      - "59980:8080"
    volumes:
      - ./config.yaml:/app/config.yaml:ro
      - ./tokenizers:/app/tokenizers:ro
      - ./YOUR_KNOWLEDGE_BASE:/data/docs:ro   # <-- your docs directory
    environment:
      - CONFIG_PATH=/app/config.yaml
    depends_on:
      postgres:
        condition: service_healthy
      qdrant:
        condition: service_healthy

  # Embedding + rerank: multi-model llama.cpp router (OpenAI-compatible).
  # Needs ./llama_server/models + models.ini (scripts/fetch-models.sh).
  # Pinned: b10818 is the first CUDA build with native Qwen3 rank-pooling
  # (ggml-org #25447); don't float the tag.
  llama-server:
    image: ghcr.io/ggml-org/llama.cpp:server-cuda12-b10818
    restart: unless-stopped
    ports:
      - "59944:8080"
    volumes:
      - ./llama_server/models:/models:ro
      - ./llama_server/models.ini:/models.ini:ro
    environment:
      - CUDA_VISIBLE_DEVICES=0
    ulimits:
      memlock: -1
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              device_ids: ["0"]
              capabilities: [gpu]
    command:
      - --models-preset
      - /models.ini
      - --models-max
      - "99"
      - --models-autoload
      - --host
      - 0.0.0.0
      - --port
      - "8080"
